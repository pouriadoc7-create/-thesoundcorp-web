# ===========================================================================
# TheSoundCorp — environment variables (copy to .env.local and fill in).
# .env.local is git-ignored, so real values / secrets never enter git.
# See DISASTER-RECOVERY.md for where each value comes from on a new server.
# ===========================================================================

# Absolute site origin used for metadata, canonical links, sitemap.xml,
# robots.txt, JSON-LD and next/image. The app already defaults to the
# production domain (https://thesoundcorp.ir) when this is unset, so you only
# need to set this to point a staging/preview deploy at its own origin.
# NOTE: this is a NEXT_PUBLIC_ var — it is baked in at BUILD time, so set it
# before `npm run build` (a runtime change needs a rebuild). Must be an
# absolute https URL with NO trailing slash.
NEXT_PUBLIC_SITE_URL=https://thesoundcorp.ir

# Port the Next.js server (`next start`) listens on. nginx reverse-proxies to
# 127.0.0.1:$PORT. Runtime-only; deploy.sh + ecosystem.config.cjs default to 3100.
PORT=3100

# ---------------------------------------------------------------------------
# Contact form email (server-only — used by app/api/contact). Put the real
# values in .env.local (NOT committed). Until they are all set, the API returns
# 503 and the form falls back to opening the visitor's mail app.
#
# Gmail example (create an App Password: Google Account → Security →
# 2-Step Verification → App passwords):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=thesound1.ir@gmail.com
#   SMTP_PASS=your-16-char-app-password   # SECRET — keep out of git
#   CONTACT_TO=thesound1.ir@gmail.com     # where enquiries land (defaults to SMTP_USER)
#   CONTACT_FROM=thesound1.ir@gmail.com   # From address (defaults to SMTP_USER)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CONTACT_TO=
CONTACT_FROM=
